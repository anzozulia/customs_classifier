# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_ORG_ID=
# Model. o4-mini shuts down 2026-10-23; gpt-5.6-terra is OpenAI's named replacement.
MODEL=gpt-5.6-terra
REASONING_EFFORT=low
# Tracing OFF by default: v1 shipped 5,482 trace batches offsite with zero consumers.
OPENAI_AGENTS_DISABLE_TRACING=1

# ---- ChatKit ----
# From platform.openai.com > org settings > security > domain allowlist.
# Register the PROD hostname days before deploy: propagation is minutes to ~30 min.
# Served to the browser at runtime via GET /api/config, never baked into the JS bundle.
CHATKIT_DOMAIN_KEY=domain_pk_localhost_dev

# ---- App ----
DATABASE_URL=postgresql://postgres:postgres@db:5432/uktzed
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# ---- Caddy / TLS (docker compose) ----
# UKTZED_DOMAIN must match a hostname registered in the OpenAI org domain allowlist,
# or ChatKit fails closed in production and unmounts the chat.
UKTZED_DOMAIN=localhost
ACME_EMAIL=ops@example.com

# ---- Postgres (docker compose) ----
POSTGRES_DB=uktzed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

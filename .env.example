# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_ORG_ID=
# Model. o4-mini shuts down 2026-10-23; gpt-5.6-terra is OpenAI's named replacement.
MODEL=gpt-5.6-terra
REASONING_EFFORT=low
# Send traces to the OpenAI Traces dashboard and retain requests on the Logs page.
# true = you can inspect every run on platform.openai.com. false = nothing leaves the app
# except the model call itself. The app's own /history records every turn either way.
OPENAI_TELEMETRY=true

# ---- ChatKit ----
# From platform.openai.com > org settings > security > domain allowlist.
# Register the PROD hostname days before deploy: propagation is minutes to ~30 min.
# Served to the browser at runtime via GET /api/config, never baked into the JS bundle.
CHATKIT_DOMAIN_KEY=domain_pk_localhost_dev

# ---- App ----
DATABASE_URL=postgresql://postgres:postgres@db:5432/uktzed
SESSION_SECRET=
LOG_LEVEL=info

# ---- Caddy / TLS (docker compose) ----
# UKTZED_DOMAIN must match a hostname registered in the OpenAI org domain allowlist,
# or ChatKit fails closed in production and unmounts the chat.
UKTZED_DOMAIN=localhost
# MUST be exactly https://<UKTZED_DOMAIN> in production — lowercase, no :443, no trailing
# slash. The CSRF check compares every POST's Origin header to this string, so a mismatch
# means every message, login and admin action is rejected with 403 while GETs keep working.
# It also decides is_production (Secure cookies, secret-required boot). Nothing cross-checks
# the two variables; the server logs its allowed origins at startup so you can eyeball it.
PUBLIC_BASE_URL=http://localhost:8000
ACME_EMAIL=ops@example.com

# ---- Postgres (docker compose) ----
POSTGRES_DB=uktzed
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
